# Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# SQL Server SA Password (must be at least 8 characters with uppercase, lowercase, number, and special char)
SA_PASSWORD=YourStrongPassword123!

# JWT Secret Key (must be at least 32 characters)
JWT_SECRET_KEY=YourSuperSecretKeyHereThatIsAtLeast32CharactersLong!